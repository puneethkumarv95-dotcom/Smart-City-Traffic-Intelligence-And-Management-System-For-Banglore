PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/smart_city_traffic
JWT_SECRET=super_secret_jwt_access_key_smart_city_2026_xyz
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_smart_city_2026_abc
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# ========================================================
# OPENSTREETMAP & OSRM ROUTING (NO API KEY REQUIRED)
# ========================================================
# Default public OSRM router: https://router.project-osrm.org
# Can be pointed to a local Docker OSRM container or leave as default
OSRM_ROUTER_URL=https://router.project-osrm.org

# ========================================================
# OPTIONAL EXTERNAL LIVE TRAFFIC API KEYS
# ========================================================
# If omitted or left empty, SCTIMS runs in transparent Demonstration Mode with simulated conditions.
TRAFFIC_PROVIDER_API_KEY=
TOMTOM_API_KEY=
MAPBOX_ACCESS_TOKEN=
HERE_API_KEY=
