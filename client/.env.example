# ========================================================
# SMART CITY TRAFFIC INTELLIGENCE - FRONTEND CONFIGURATION
# ========================================================

# Backend Express API Base URL
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket Gateway
VITE_SOCKET_URL=http://localhost:5000

# ========================================================
# OPENSTREETMAP CONFIGURATION (NO API KEY REQUIRED)
# ========================================================
# Standard OpenStreetMap: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# CartoDB Voyager:       https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# CartoDB Dark Matter:   https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
VITE_OSM_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Default City Map Coordinates (Bengaluru, Karnataka, India)
VITE_MAP_CENTER_LAT=12.9716
VITE_MAP_CENTER_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=13
